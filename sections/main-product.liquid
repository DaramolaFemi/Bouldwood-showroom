{% assign current_variant = product.selected_or_first_available_variant %}
<section class="product-shell" data-product-root>
  <div class="product-media">
    {% for media in product.media %}
      {{ media | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1280, 1600, 1800', sizes: '(max-width: 767px) 100vw, 58vw', alt: media.alt }}
    {% endfor %}
  </div>
  <div class="product-copy">
    <p class="eyebrow">BOULDWOOD / {{ product.type | upcase }}</p>
    <h1>{{ product.title | escape }}</h1>
    <p class="product-price">{{ current_variant.price | money }}</p>
    <div class="rte product-description">{{ product.description }}</div>

    {% form 'product', product, class: 'product-form' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
          <select id="Option-{{ section.id }}-{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">
            {% for value in option.values %}
              <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
            {% endfor %}
          </select>
        {% endfor %}
        <select name="id" class="visually-hidden" data-variant-select aria-label="Variant">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" data-options="{{ variant.options | join: '||' | escape }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title }}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endunless %}

      <label for="Quantity-{{ section.id }}">Quantity</label>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" max="99" value="1">
      <button type="submit" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}
      </button>
    {% endform %}

    <div class="product-notes">
      {% if product.tags contains 'Linen upholstery' %}<p><strong>Material</strong> Linen upholstery, hardwood frame</p>{% endif %}
      {% if product.tags contains 'Oak timber' %}<p><strong>Material</strong> Oak timber</p>{% endif %}
      {% if product.tags contains 'Wool blend' %}<p><strong>Material</strong> Wool blend, steel base</p>{% endif %}
      <p><strong>Delivery</strong> Calculated at checkout.</p>
    </div>
  </div>
</section>
{% schema %}
{"name":"Main product","settings":[]}
{% endschema %}