<section class="collection-shell">
  <header class="collection-header">
    <p class="eyebrow">BOULDWOOD COLLECTION</p>
    <h1>The collection</h1>
    <p>Considered furniture for rooms that are lived in.</p>
  </header>
  <div class="product-grid">
    {% assign shown = 0 %}
    {% for product in collection.products %}
      {% if product.vendor == 'Bouldwood' %}
        {% render 'product-card', product: product %}
        {% assign shown = shown | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if shown == 0 %}<p class="bw-empty">No Bouldwood pieces are available yet.</p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Main collection","settings":[]}
{% endschema %}