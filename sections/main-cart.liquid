<section class="cart-shell">
  <h1>Your bag</h1>
  {% if cart.empty? %}
    <p>Your bag is empty. <a href="{{ routes.all_products_collection_url }}">Explore the collection</a>.</p>
  {% else %}
    {% form 'cart', cart %}
      {% for item in cart.items %}
        <article class="cart-row">
          {% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}
          <div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.final_line_price | money }}</p></div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
          <a href="{{ item.url_to_remove }}">Remove</a>
        </article>
      {% endfor %}
      <div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button type="submit" name="update">Update bag</button><button type="submit" name="checkout">Checkout</button></div>
    {% endform %}
  {% endif %}
</section>
{% schema %}
{"name":"Main cart","settings":[]}
{% endschema %}